rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function authEmail() {
      return signedIn() && request.auth.token.email is string
        ? request.auth.token.email.lower()
        : '';
    }

    function emailVerified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function profileFieldLocked() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['plan', 'maxMaps', 'codeUsed', 'proActivatedAt']);
    }

    function profileCreateLocked() {
      return request.resource.data.keys()
        .hasAny(['plan', 'maxMaps', 'codeUsed', 'proActivatedAt']);
    }

    function canViewSharedMap() {
      return signedIn()
        && resource.data.keys().hasAll(['shareSettings'])
        && resource.data.shareSettings is map
        && (
          resource.data.shareSettings.accessLevel in ['view', 'edit']
          || (
            resource.data.shareSettings.accessLevel == 'restricted'
            && emailVerified()
            && authEmail().size() > 0
            && resource.data.shareSettings.keys().hasAll(['invitedEmails'])
            && resource.data.shareSettings.invitedEmails is list
            && authEmail() in resource.data.shareSettings.invitedEmails
          )
        );
    }

    function canEditSharedMap() {
      return signedIn()
        && resource.data.keys().hasAll(['shareSettings'])
        && resource.data.shareSettings is map
        && (
          resource.data.shareSettings.accessLevel == 'edit'
          || (
            resource.data.shareSettings.accessLevel == 'restricted'
            && emailVerified()
            && authEmail().size() > 0
            && resource.data.shareSettings.keys().hasAll(['editorEmails'])
            && resource.data.shareSettings.editorEmails is list
            && authEmail() in resource.data.shareSettings.editorEmails
          )
        );
    }

    function shareSettingsShape(settings) {
      return settings is map
        && settings.accessLevel in ['view', 'edit', 'restricted']
        && (!('allowCopy' in settings) || settings.allowCopy is bool)
        && (!('invitedMembers' in settings) || settings.invitedMembers is list)
        && (!('invitedEmails' in settings) || settings.invitedEmails is list)
        && (!('editorEmails' in settings) || settings.editorEmails is list);
    }

    function ownerMapShape(userId) {
      return request.resource.size() < 1048576
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 300
        && request.resource.data.data is map
        && request.resource.data.data.size() <= 40
        && (
          !('nodeCount' in request.resource.data)
          || (
            request.resource.data.nodeCount is int
            && request.resource.data.nodeCount >= 0
            && request.resource.data.nodeCount <= 100000
          )
        )
        && (
          !('userId' in request.resource.data)
          || request.resource.data.userId == userId
        )
        && (
          !('shareSettings' in request.resource.data)
          || shareSettingsShape(request.resource.data.shareSettings)
        );
    }

    function collabMapUpdate() {
      return canEditSharedMap()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['data', 'nodeCount', 'updatedAt'])
        && request.resource.data.data is map
        && request.resource.data.data.size() <= 40
        && request.resource.size() < 1048576
        && request.resource.data.nodeCount is int
        && request.resource.data.nodeCount >= 0
        && request.resource.data.nodeCount <= 100000;
    }

    // Pro codes, capture records, and rate-limit counters are server-only (Admin SDK).
    match /pro_codes/{code} {
      allow read, write: if false;
    }
    match /pro_captures/{captureId} {
      allow read, write: if false;
    }
    match /rate_limits/{bucketId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && !profileCreateLocked();
      allow update: if isOwner(userId) && !profileFieldLocked();
      allow delete: if isOwner(userId);

      match /maps/{mapId} {
        allow get: if isOwner(userId) || canViewSharedMap();
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && ownerMapShape(userId);
        allow update: if (isOwner(userId) && ownerMapShape(userId))
          || (!isOwner(userId) && collabMapUpdate());
        allow delete: if isOwner(userId);
      }
    }
  }
}
